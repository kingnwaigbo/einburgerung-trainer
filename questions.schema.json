{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EinbuergerungQuestionsDataset",
  "type": "object",
  "required": ["dataset_version", "schema_version", "questions"],
  "properties": {
    "dataset_version": { "type": "string" },
    "schema_version": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_collection", "topic", "subtopic", "type", "question", "correct_answer", "difficulty", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^(GEM|KAN)-[A-Z0-9_-]+" },
          "source_collection": { "enum": ["gemeinde", "kanton"] },
          "topic": { "type": "string" },
          "subtopic": { "type": "string" },
          "type": { "enum": ["flashcard", "multiple_choice", "interview"] },
          "question": { "type": "string" },
          "correct_answer": { "type": "string" },
          "explanation": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 4,
            "maxItems": 4
          },
          "difficulty": { "enum": ["einfach", "mittel", "anspruchsvoll"] },
          "source": {
            "type": "object",
            "required": ["title", "year"],
            "properties": {
              "title": { "type": "string" },
              "year": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}